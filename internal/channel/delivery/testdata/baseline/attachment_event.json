{
  "name": "attachment_event",
  "calls": [
    {
      "op": "open",
      "stream": 1,
      "target": "target-id",
      "reply_to": "src-1"
    },
    {
      "op": "push",
      "stream": 1,
      "event": {
        "type": "status",
        "status": "started"
      }
    },
    {
      "op": "push",
      "stream": 1,
      "event": {
        "type": "attachment",
        "attachments": [
          {
            "type": "image",
            "kind": "public_url",
            "ref": "https://example.test/a.png",
            "name": "a.png"
          }
        ]
      }
    },
    {
      "op": "push",
      "stream": 1,
      "event": {
        "type": "delta",
        "delta": "see attached",
        "phase": "text"
      }
    },
    {
      "op": "push",
      "stream": 1,
      "event": {
        "type": "agent_end"
      }
    },
    {
      "op": "push",
      "stream": 1,
      "event": {
        "type": "final",
        "final": {
          "text": "see attached",
          "format": "plain",
          "reply_to": "src-1"
        }
      }
    },
    {
      "op": "push",
      "stream": 1,
      "event": {
        "type": "status",
        "status": "completed"
      }
    },
    {
      "op": "close",
      "stream": 1
    }
  ],
  "observed": [
    {
      "type": "final",
      "final": {
        "text": "hello"
      }
    },
    {
      "type": "status",
      "status": "started"
    },
    {
      "type": "attachment",
      "attachments": [
        {
          "type": "image",
