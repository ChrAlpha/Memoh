          "name": "a.png"
        }
      ]
    },
    {
      "type": "delta",
      "delta": "see attached",
      "phase": "text"
    },
    {
      "type": "agent_end"
    },
    {
      "type": "final",
      "final": {
        "text": "see attached",
        "reply_to": "src-1"
      }
    },
    {
